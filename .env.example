# Copiar este archivo a .env y completar con tus datos reales.
# NUNCA subas el .env al repositorio.

# Credenciales de tu cuenta en https://prenotami.esteri.it
PRENOTAMI_EMAIL=tu-email@ejemplo.com
PRENOTAMI_PASSWORD=tu-password

# ID del servicio a reservar en la sede de Montevideo (verificados 07/2026):
#   5679 = Cittadinanza per discendenza maggiorenni (L. 74/2025)  <- ciudadanía adultos
#   5896 = Ciudadanía hijos menores (turnos a partir de 06/2026)
#   5126 = Pasaporte | 5199 = CIE | 5322 = Estado civil | 4947 = Legalizaciones
# Si cambia, es el número de la URL https://prenotami.esteri.it/Services/Booking/<ID>
SERVICE_ID=5679

# true = navegador invisible (headless). false = ver el navegador (útil para
# depurar o si aparece un CAPTCHA que hay que resolver a mano).
HEADLESS=true

# Cada cuántos segundos reintentar cuando no hay disponibilidad (se le suma
# un jitter aleatorio). No usar valores muy bajos: sobrecargar el sitio puede
# hacer que bloqueen tu cuenta o tu IP.
CHECK_INTERVAL_SECONDS=120

# Cantidad máxima de intentos antes de rendirse (0 = infinito)
MAX_ATTEMPTS=0

# Archivo CSV con los datos de la persona
CSV_DATOS=datos.csv

# Carpeta donde guardar screenshots de evidencia
EVIDENCIA_DIR=evidencia

# Cantidad máxima de meses hacia adelante a explorar en el calendario
MAX_MESES_CALENDARIO=8
